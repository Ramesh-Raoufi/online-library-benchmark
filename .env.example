# SQLite is for development only; never used in the MySQL/CockroachDB comparison.
DB_ENGINE=sqlite
SQLITE_PATH=./data/library.sqlite
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
POOL_SIZE=10
# For MySQL: DB_ENGINE=mysql and the corresponding URL below.
MYSQL_URL=mysql://library:local-library-password@127.0.0.1:3306/library
# For CockroachDB: DB_ENGINE=cockroach and the corresponding URL below.
COCKROACH_URL=postgresql://root@127.0.0.1:26257/library?sslmode=disable
# Local Docker passwords only. Replace them before sharing a server.
MYSQL_PASSWORD=local-library-password
MYSQL_ROOT_PASSWORD=local-root-password
# Both benchmark database names MUST end in _benchmark.
BENCH_MYSQL_URL=mysql://library:local-library-password@127.0.0.1:3306/library_benchmark
BENCH_COCKROACH_URL=postgresql://root@127.0.0.1:26257/library_benchmark?sslmode=disable
BENCH_ROWS=1000
BENCH_OPERATIONS=300
BENCH_CONCURRENCY=5
BENCH_REPETITIONS=3
BENCH_WARMUP=30
# Required only when running npm run setup; no built-in password.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Library Administrator
ADMIN_PASSWORD=
# Chapter 3 normalized-schema pilot. Scale 1 reproduces the proposed row counts.
STUDY_SCALE=0.01
STUDY_OPERATIONS=1000
STUDY_WARMUP=100
STUDY_REPETITIONS=5
STUDY_CONCURRENCY=1,10,25,50,100
# Optional fixed-duration protocol: warmup 300 seconds, measured 600 seconds.
# Zero uses operation-count pilot settings above.
STUDY_WARMUP_SECONDS=0
STUDY_DURATION_SECONDS=0
